    <div class="dot" style="left:6%;top:54%">16</div>
    <div class="dot" style="left:52%;top:48%">32</div>
    <div class="dot" style="left:64%;top:42%">14</div>
    <div class="dot" style="left:71%;top:50%">15</div>
    <div class="dot" style="left:44%;top:56%">26</div>
    <div class="dot" style="left:60%;top:60%">25</div>
    <div class="dot" style="left:66%;top:67%">17</div>
    <div class="dot" style="left:10%;top:66%">9</div>
    <div class="dot" style="left:22%;top:70%">24</div>
    <div class="dot" style="left:31%;top:74%">33</div>
    <div class="dot" style="left:14%;top:78%">29</div>
    <div class="dot" style="left:38%;top:80%">18</div>
    <div class="dot" style="left:7%;top:84%">7</div>
    <div class="dot" style="left:19%;top:88%">22</div>
    <div class="dot" style="left:27%;top:91%">5</div>
    <div class="dot" style="left:36%;top:87%">21</div>
