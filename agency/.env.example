# Agency — маркетинговое ИИ-агентство экосистемы kostya

# --- Telegram (новый бот) ---
AGENCY_BOT_TOKEN=
# Супер-админ: полный доступ + управление админами
SUPER_ADMIN_ID=304631563
# Опциональный bootstrap-список (через запятую). Обычных админов — /admin_add
AGENCY_ADMIN_IDS=
AGENCY_BRIEF_CHAT_ID=

# --- Agency DB (RW) ---
AGENCY_DB_HOST=localhost
AGENCY_DB_PORT=5432
AGENCY_DB_NAME=agency
AGENCY_DB_USER=agency_user
AGENCY_DB_PASSWORD=

# --- Biblia DB (RO) ---
BIBLIA_DB_HOST=localhost
BIBLIA_DB_PORT=5432
BIBLIA_DB_NAME=biblia_bot
BIBLIA_DB_USER=agency_ro
BIBLIA_DB_PASSWORD=

# --- Club DB (RO) ---
CLUB_DB_HOST=localhost
CLUB_DB_PORT=5432
CLUB_DB_NAME=club_db
CLUB_DB_USER=agency_ro
CLUB_DB_PASSWORD=

# --- LLM ---
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_STRONG_MODEL=gpt-4o
OPENAI_WEB_MODEL=gpt-4o-mini-search-preview
DEEPSEEK_MODEL=deepseek-v4-flash
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- RAG (optional read-only chroma from avatar) ---
RAG_ENABLED=false
RAG_CHROMA_PERSIST_DIR=/home/appuser/dev/kostya/avatar_kostya/chroma_data

# --- Runtime ---
CRON_HOUR_MSK=3
CRON_MINUTE_MSK=0
DIALOG_SAMPLE_LIMIT=80
ENABLE_DRAFT_PR=false
GITHUB_BIBLIA_PATH=/home/appuser/dev/kostya/biblia
